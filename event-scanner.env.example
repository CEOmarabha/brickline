# Copy to secrets/event-scanner.env (gitignored) or export in the shell.
# Never commit real cookies, tokens, or storage_state files.

# Optional LLM extract (phones/emails are always stripped)
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-sonnet-5-5

# Optional Postgres (web/migrations/009_event_leads.sql)
# DATABASE_URL=postgres://...

# Licensed providers (public logged-out collection)
# APIFY_TOKEN=
# APIFY_FACEBOOK_ACTOR=apify/facebook-events-scraper
# APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper
# APIFY_TIKTOK_ACTOR=clockworks/tiktok-scraper
# SERPAPI_API_KEY=
# FIRECRAWL_API_KEY=
# EVENTBRITE_TOKEN=
# MEETUP_TOKEN=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# X_BEARER_TOKEN=

# Team Facebook / Instagram / TikTok sessions (real accounts only).
# Prefer Playwright storage_state from:
#   python -m engine.collect.social.save_session facebook
FB_STORAGE_STATE=secrets/facebook.storage.json
IG_STORAGE_STATE=secrets/instagram.storage.json
TIKTOK_STORAGE_STATE=secrets/tiktok.storage.json

# Or Cookie-Editor JSON / Netscape cookies.txt
# FB_COOKIES_FILE=secrets/facebook.cookies.json
# IG_COOKIES_FILE=secrets/instagram.cookies.json
# TIKTOK_COOKIES_FILE=secrets/tiktok.cookies.json

# Cookie header (least preferred)
# FB_COOKIE=
# IG_COOKIE=
# TIKTOK_COOKIE=

# Joined Facebook groups and extra Instagram profiles to visit (comma-separated)
# FB_GROUP_URLS=https://www.facebook.com/groups/example
# IG_PROFILE_URLS=https://www.instagram.com/choosechicago/

# Per-account throttles (seconds / counts). Defaults are already conservative.
# FB_MIN_DELAY=15
# FB_MAX_DELAY=32
# FB_MAX_PER_RUN=18
# FB_MAX_PER_HOUR=40
# IG_MIN_DELAY=12
# IG_MAX_DELAY=28
# IG_MAX_PER_RUN=16
# IG_MAX_PER_HOUR=36
# TIKTOK_MIN_DELAY=12
# TIKTOK_MAX_DELAY=30
# TIKTOK_MAX_PER_RUN=14
# TIKTOK_MAX_PER_HOUR=32

# Extra public iCal feeds
# EVENT_ICAL_URLS=
